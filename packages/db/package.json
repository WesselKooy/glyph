{
  "name": "@glyph/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "prebuild": "pnpm generate",
    "pretypecheck": "pnpm generate",
    "prisma": "prisma --schema prisma/schema.prisma",
    "studio": "prisma studio --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0"
  },
  "devDependencies": {
    "prisma": "^6.17.0",
    "typescript": "^5.7.2"
  }
}
