{
  "name": "glyph",
  "private": true,
  "scripts": {
    "api:build": "pnpm --filter @glyph/api build",
    "api:dev": "pnpm --filter @glyph/api dev",
    "api:lint": "pnpm --filter @glyph/api lint",
    "api:typecheck": "pnpm --filter @glyph/api typecheck",
    "build": "pnpm -r --if-present build",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @glyph/db generate",
    "db:migrate:dev": "pnpm --filter @glyph/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @glyph/db migrate:deploy",
    "db:migrate:status": "pnpm --filter @glyph/db migrate:status",
    "db:seed": "pnpm --filter @glyph/db seed",
    "db:studio": "pnpm --filter @glyph/db studio",
    "db:up": "docker compose up -d postgres",
    "dev": "pnpm --filter @glyph/web dev",
    "jobs:dev": "pnpm --filter @glyph/jobs dev",
    "jobs:typecheck": "pnpm --filter @glyph/jobs typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "tickets:create": "node scripts/create-issues.mjs",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
