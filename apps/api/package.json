{
  "name": "@glyph/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "lint": "eslint src --max-warnings=0",
    "prebuild": "pnpm --filter @glyph/db generate",
    "pretypecheck": "pnpm --filter @glyph/db generate",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.12.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.8.1"
  }
}
